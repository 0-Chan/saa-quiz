{
  "name": "saa-quiz",
  "version": "0.3.2",
  "description": "AWS SAA 시험 대비용 로컬 문제 풀이 CLI (확신도 기반 XP)",
  "keywords": [
    "aws",
    "saa-c03",
    "quiz",
    "cli",
    "certification"
  ],
  "license": "MIT",
  "author": "0Chan-smc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0-Chan/saa-quiz.git"
  },
  "homepage": "https://github.com/0-Chan/saa-quiz#readme",
  "bugs": {
    "url": "https://github.com/0-Chan/saa-quiz/issues"
  },
  "type": "module",
  "bin": {
    "saa": "dist/cli.js"
  },
  "engines": {
