{
  "name": "saa-quiz",
  "version": "0.5.0",
  "description": "AWS Certified Solutions Architect Associate (SAA-C03) exam practice quiz CLI with confidence-based scoring · AWS SAA 시험 대비 문제 풀이 CLI",
  "keywords": [
    "saa-quiz",
    "aws",
    "saa-c03",
    "saa",
    "aws-saa",
    "solutions-architect",
    "solutions-architect-associate",
    "aws-certification",
    "aws-certified",
    "certification",
    "exam",
    "exam-prep",
    "practice-test",
    "quiz",
    "study",
    "cli",
    "terminal"
  ],
  "license": "MIT",
  "author": "0Chan-smc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0-Chan/saa-quiz.git"
  },
  "homepage": "https://github.com/0-Chan/saa-quiz#readme",
  "bugs": {
    "url": "https://github.com/0-Chan/saa-quiz/issues"
  },
  "type": "module",
  "bin": {
    "saa": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm test && npm run build",
    "check:release": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "commander": "^15.0.0",
    "gray-matter": "^4.0.3",
    "update-notifier": "^7.3.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/update-notifier": "^6.0.8",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ]
}
